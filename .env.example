# Tunnel Excavation Detection System - Environment Variables

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Debug mode
DEBUG=false

# Analyzer mode: python (real model inference) | mock (test/demo)
ANALYZER_MODE=python

# Model weights (relative to ./model_weights)
YOLO_WEIGHTS=yolo_best.pt
CRACK_YOLO_WEIGHTS=crack_best.pt
# Require SAM2 to produce final face mask (recommended true)
SAM2_STRICT_FACE_SEGMENTATION=true
# SAM2 config name (Hydra config under SAM2 package)
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_b+.yaml
